# Secrets can be 1Password references (op://vault/item/field), resolved at container start with the service-account
# token in /etc/op/token (see README). Plain values work too (and are what `pnpm dev` needs).
PLAID_CLIENT_ID=op://my-server/fin/PLAID_CLIENT_ID
PLAID_SECRET=op://my-server/fin/PLAID_SECRET
# Database encryption key, 64 hex chars (openssl rand -hex 32). Optional; losing it loses the data.
DB_KEY=op://my-server/fin/DB_KEY
# sandbox | production
PLAID_ENV=production
PORT=3000
# Required for OAuth banks (Wells Fargo, Amex, Schwab, ...) in production. Must be https://<host>/accounts and
# registered under Allowed redirect URIs in the Plaid Dashboard. Leave empty for sandbox.
PLAID_REDIRECT_URI=https://fin.example.com/accounts
# Optional: origin passkeys are bound to. Defaults to the address each request arrives on (via Caddy).
# APP_ORIGIN=https://fin.example.com
# Cron expression for the daily sync (server local time)
SYNC_CRON=0 6 * * *
# Timezone for the daily sync (compose)
TZ=America/New_York
# Hostname(s) Caddy serves the app on (comma-separated)
HOSTNAMES=fin.example.com
