PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=production
PORT=3000
# Required for OAuth banks (Wells Fargo, Amex, Schwab, ...) in production: must be https
# and registered in the Plaid Dashboard. Leave empty for sandbox.
PLAID_REDIRECT_URI=
# Cron expression for the daily sync (server local time)
SYNC_CRON=0 6 * * *
# Timezone for the daily sync (compose)
TZ=America/New_York
# Hostname(s) Caddy serves the app on (comma-separated)
HOSTNAMES=fin.example.com
