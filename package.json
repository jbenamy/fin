{
  "name": "fin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/server.ts",
    "dev:web": "pnpm -C web dev",
    "build": "pnpm -C web build && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit && pnpm -C web check",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.1.0",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "express": "^5.3.0",
    "node-cron": "^4.6.0",
    "plaid": "^47.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  }
}
