{
  "name": "fin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "node-cron": "^4.6.0",
    "plaid": "^47.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.9"
  }
}
