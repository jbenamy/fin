{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": true, "checkJs": true, "strict": false, "noEmit": true, "skipLibCheck": true, "types": [],
    "noUnusedLocals": true, "noUnusedParameters": true,
    "paths": { "/shared.js": ["./public/shared.js"], "/js/*": ["./public/js/*"] }
  },
  "include": ["public/**/*.js", "types/*.d.ts"]
}
